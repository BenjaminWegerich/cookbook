{
  "name": "@cookbook/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free TypeScript module: deterministic scaling, additional-unit selection, recipe parsing (no React, no DOM).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:ladder": "node scripts/generate-ladder.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
