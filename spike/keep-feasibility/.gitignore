# Python virtual environment for this spike (created locally, never committed).
.venv/

# Local secrets: the master token and device id. A master token grants full
# access to the account it belongs to, so this file must never be committed.
.env

# Cached gkeepapi state and spike test artifacts.
state.json
before-write.json
*.snapshot.json

# Gate 2 health check log (records the host's public IP over time).
gate2-log.jsonl

# Python bytecode caches.
__pycache__/

# Local gcloud SDK and its credential store (CLOUDSDK_CONFIG), for the Gate 2 deploy.
.tools/
