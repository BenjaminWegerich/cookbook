# Copy to .env and fill in your values. Never commit .env (see .gitignore).
#
# Google OAuth client ID (Web application) for Google Drive access.
# Create it in the Google Cloud Console: APIs & Services → Credentials →
# Create credentials → OAuth client ID → Web application.
# Authorized JavaScript origins: https://BenjaminWegerich.github.io and
# http://localhost:5173 (dev server).
VITE_GOOGLE_CLIENT_ID=

# Keep gateway URL — the deployed Cloud Run service URL (see
# apps/keep-gateway/README.md; `gcloud run services list --region europe-west3`).
# Not a secret: the URL is public, and what protects the notes is the caller's
# Google sign-in (`openid email`), which the gateway checks against its address
# allowlist. The same client ID above is the audience it expects, so a gateway
# pointed at a different client refuses every call.
# Leave empty to switch every Keep feature off — the app then works exactly as
# before (N5: the core must not depend on Keep).
VITE_KEEP_GATEWAY_URL=

# Export host URL — the Apps Script web app that serves a recipe's HTML export
# to the cooking view (see apps/export-host/README.md; the deployed URL ends in
# /exec). Not a secret: it ships in the browser bundle, and it serves only
# `<title>.html` files from the Cookbook folder.
# Why it exists: a Drive link renders the stored file without running the
# cooking view's script, so its size picker and step navigation stay dead in
# Keep's in-app browser, and the promised size (the URL fragment) never reaches
# the page. The host serves the file itself and takes the size as a query
# parameter. Leave empty to fall back to the Drive viewer link.
VITE_EXPORT_HOST_URL=
